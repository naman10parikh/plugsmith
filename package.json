{
  "name": "plugsmith",
  "version": "0.1.0",
  "private": true,
  "description": "Turns any repo's skills+hooks+commands+MCP into a .claude-plugin/marketplace.json bundle.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "node dist/cli.js",
    "verify": "pnpm build && pnpm test"
  },
  "bin": { "plugsmith": "./dist/cli.js" },
  "engines": { "node": ">=18" },
  "keywords": [
    "claude",
    "agent",
    "harness",
    "plugin",
    "marketplace",
    "skills",
    "hooks",
    "mcp",
    "dev-tools"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
